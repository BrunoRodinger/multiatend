{
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/captura",
      "destination": "/lp-captura",
      "permanent": false
    },
    {
      "source": "/captura/:path*",
      "destination": "/lp-captura/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/materiais/:path*",
      "destination": "/public/materiais/:path*"
    }
  ]
}
